<%= form_with model: @budget, class: "space-y-5" do |f| %>
  <% if @budget.errors.any? %>
    <div class="rounded-xl bg-red/10 px-4 py-3 text-sm text-red">
      <p class="font-bold">Couldn't save budget:</p>
      <ul class="mt-1 list-inside list-disc">
        <% @budget.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :category_id, "Budget Category", class: "mb-1 block text-sm font-bold text-muted" %>
    <% if @available_categories.any? %>
      <%= f.collection_select :category_id, @available_categories, :id, :name, {},
            class: "w-full rounded-lg border border-beige px-4 py-2.5 text-sm" %>
    <% else %>
      <p class="text-sm text-muted">All your categories already have budgets.</p>
    <% end %>
  </div>

  <div>
    <%= f.label :limit, "Maximum Spend ($)", class: "mb-1 block text-sm font-bold text-muted" %>
    <%= f.number_field :limit, step: "0.01", min: "0.01", required: true, placeholder: "e.g. 2000",
          class: "w-full rounded-lg border border-beige px-4 py-2.5 text-sm" %>
  </div>

  <div>
    <%= f.label :color, "Theme", class: "mb-1 block text-sm font-bold text-muted" %>
    <%= f.select :color, theme_colors, {},
          class: "w-full rounded-lg border border-beige px-4 py-2.5 text-sm" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-navy px-5 py-3 text-sm font-bold text-white cursor-pointer" %>
    <%= link_to "Cancel", budgets_path, class: "text-sm text-muted" %>
  </div>
<% end %>
