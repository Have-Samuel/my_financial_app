<div class="mx-auto max-w-6xl space-y-8">
  <h1 class="text-3xl font-bold">Overview</h1>

  <%# Summary cards %>
  <div class="grid gap-6 sm:grid-cols-3">
    <div class="rounded-xl bg-navy p-6 text-white">
      <p class="text-sm text-white/70">Current Balance</p>
      <p class="mt-3 text-4xl font-bold"><%= money(@balance_cents) %></p>
    </div>
    <div class="rounded-xl bg-white p-6">
      <p class="text-sm text-muted">Income</p>
      <p class="mt-3 text-4xl font-bold"><%= money(@income_cents) %></p>
    </div>
    <div class="rounded-xl bg-white p-6">
      <p class="text-sm text-muted">Expenses</p>
      <p class="mt-3 text-4xl font-bold"><%= money(@expenses_cents) %></p>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-5">
    <div class="space-y-6 lg:col-span-3">

      <%# Pots preview %>
      <section class="rounded-xl bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold">Pots</h2>
          <span class="text-sm text-muted">See Details</span>
        </div>
        <% if @pots.any? %>
          <div class="mt-4 flex items-center gap-5 rounded-xl bg-beige p-4">
            <div class="flex h-10 w-12 items-center justify-center rounded-lg bg-teal">
              <i class="fa-solid fa-jar text-white"></i>
            </div>
            <div>
              <p class="text-xs text-muted">Total Saved</p>
              <p class="text-3xl font-bold"><%= money(@pots.sum(&:saved_cents)) %></p>
            </div>
          </div>
          <ul class="mt-4 grid grid-cols-2 gap-4">
            <% @pots.first(4).each do |pot| %>
              <li class="flex items-center gap-3">
                <span class="h-8 w-1 rounded-full" style="background-color: <%= pot.color || '#277c78' %>"></span>
                <div>
                  <p class="text-xs text-muted"><%= pot.name %></p>
                  <p class="text-sm font-bold"><%= money(pot.saved_cents) %></p>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-4 text-sm text-muted">No savings pots yet.</p>
        <% end %>
      </section>

      <%# Recent transactions %>
      <section class="rounded-xl bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold">Transactions</h2>
          <%= link_to "View All", transactions_path, class: "text-sm text-muted hover:text-navy" %>
        </div>
        <% if @recent_transactions.any? %>
          <ul class="mt-2 divide-y divide-beige">
            <% @recent_transactions.each do |transaction| %>
              <li class="flex items-center gap-4 py-3">
                <% if transaction.avatar.present? %>
                  <%= image_tag transaction.avatar, alt: "", class: "h-10 w-10 rounded-full object-cover" %>
                <% else %>
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-beige text-sm font-bold text-muted">
                    <%= transaction.recipient.first.upcase %>
                  </span>
                <% end %>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-bold"><%= transaction.recipient %></p>
                  <p class="text-xs text-muted"><%= transaction.category.name %></p>
                </div>
                <div class="text-right">
                  <p class="text-sm font-bold <%= 'text-teal' if transaction.income? %>">
                    <%= transaction.income? ? "+" : "-" %><%= money(transaction.amount_cents) %>
                  </p>
                  <p class="text-xs text-muted"><%= transaction.occurred_on.strftime("%d %b %Y") %></p>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-4 text-sm text-muted">No transactions yet.</p>
        <% end %>
      </section>
    </div>

    <div class="space-y-6 lg:col-span-2">

      <%# Budgets donut %>
      <section class="rounded-xl bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold">Budgets</h2>
          <%= link_to "See Details", budgets_path, class: "text-sm text-muted hover:text-navy" %>
        </div>
        <% if @budgets.any? %>
          <% total_limit = @budgets.sum(&:limit_cents) %>
          <% total_spent = @budgets.sum { |b| b.spent_this_month_cents } %>
          <div class="mt-4 flex items-center gap-6">
            <div class="relative shrink-0">
              <%= donut_chart(@budgets.map { |b| { value: b.limit_cents, color: b.color || "#97a0ac" } }) %>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <p class="text-2xl font-bold"><%= money(total_spent) %></p>
                <p class="text-xs text-muted">of <%= money(total_limit) %> limit</p>
              </div>
            </div>
            <ul class="flex-1 space-y-3">
              <% @budgets.each do |budget| %>
                <li class="flex items-center gap-3">
                  <span class="h-8 w-1 rounded-full" style="background-color: <%= budget.color || '#97a0ac' %>"></span>
                  <div class="flex-1">
                    <p class="text-xs text-muted"><%= budget.category.name %></p>
                    <p class="text-sm font-bold"><%= money(budget.limit_cents) %></p>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        <% else %>
          <p class="mt-4 text-sm text-muted">No budgets yet.</p>
        <% end %>
      </section>

      <%# Recurring bills summary %>
      <section class="rounded-xl bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold">Recurring Bills</h2>
          <span class="text-sm text-muted">See Details</span>
        </div>
        <% paid = @bills.select(&:paid?) %>
        <% upcoming = @bills.select { |b| !b.paid? && !b.due_soon? } %>
        <% due_soon = @bills.select { |b| !b.paid? && b.due_soon? } %>
        <ul class="mt-4 space-y-3">
          <li class="flex items-center justify-between rounded-xl border-l-4 border-teal bg-beige px-4 py-4">
            <span class="text-sm text-muted">Paid Bills</span>
            <span class="text-sm font-bold"><%= money(paid.sum(&:amount_cents)) %></span>
          </li>
          <li class="flex items-center justify-between rounded-xl border-l-4 border-[#f2cdac] bg-beige px-4 py-4">
            <span class="text-sm text-muted">Upcoming Bills</span>
            <span class="text-sm font-bold"><%= money(upcoming.sum(&:amount_cents)) %></span>
          </li>
          <li class="flex items-center justify-between rounded-xl border-l-4 border-[#82c9d7] bg-beige px-4 py-4">
            <span class="text-sm text-muted">Due Soon</span>
            <span class="text-sm font-bold"><%= money(due_soon.sum(&:amount_cents)) %></span>
          </li>
        </ul>
      </section>
    </div>
  </div>
</div>
