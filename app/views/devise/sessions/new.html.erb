<div class="rounded-xl bg-card p-8">
  <div class="mb-6 text-center">
    <p class="text-2xl font-bold">finance</p>
    <h1 class="mt-4 text-lg font-bold">Log in</h1>
    <p class="mt-1 text-sm text-muted">Welcome back — enter your details below.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
    <div>
      <%= f.label :email, class: "mb-1.5 block text-xs font-bold text-muted" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com",
            class: "w-full rounded-lg border border-beige bg-beige px-4 py-3 text-sm transition-colors placeholder:text-muted/50" %>
    </div>

    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <%= f.label :password, class: "block text-xs font-bold text-muted" %>
        <%= link_to "Forgot?", new_password_path(resource_name), class: "text-xs text-muted hover:text-navy" %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••",
            class: "w-full rounded-lg border border-beige bg-beige px-4 py-3 text-sm transition-colors placeholder:text-muted/50" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-beige" %>
        <%= f.label :remember_me, class: "text-sm text-muted" %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "w-full cursor-pointer rounded-lg bg-navy px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-[#3a3940] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy/50" %>
  <% end %>

  <div class="mt-5 text-center">
    <%= render "devise/shared/links" %>
  </div>
</div>
