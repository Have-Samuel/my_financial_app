<div class="rounded-xl bg-card p-8">
  <div class="mb-6 text-center">
    <p class="text-2xl font-bold">finance</p>
    <h1 class="mt-4 text-lg font-bold">Forgot your password?</h1>
    <p class="mt-1 text-sm text-muted">Enter your email and we'll send reset instructions.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "mb-1.5 block text-xs font-bold text-muted" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com",
            class: "w-full rounded-lg border border-beige bg-beige px-4 py-3 text-sm transition-colors placeholder:text-muted/50" %>
    </div>

    <%= f.submit "Send reset instructions", class: "w-full cursor-pointer rounded-lg bg-navy px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-[#3a3940] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy/50" %>
  <% end %>

  <div class="mt-5 text-center">
    <%= render "devise/shared/links" %>
  </div>
</div>
