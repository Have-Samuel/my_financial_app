<aside class="sticky top-0 hidden h-screen w-72 shrink-0 flex-col rounded-r-2xl bg-navy pr-6 text-beige lg:flex">
  <div class="px-8 py-10 text-2xl font-bold tracking-tight">finance</div>

  <nav class="flex-1 space-y-1">
    <% nav_items.each do |item| %>
      <% if item[:path] %>
        <% active = current_page?(item[:path]) %>
        <%= link_to item[:path],
              class: "flex items-center gap-4 rounded-r-xl border-l-4 px-8 py-4 text-sm font-bold transition-colors #{active ? 'border-teal bg-beige text-navy' : 'border-transparent text-muted hover:text-beige'}" do %>
          <i class="fa-solid <%= item[:icon] %> <%= 'text-teal' if active %>"></i>
          <%= item[:label] %>
        <% end %>
      <% else %>
        <span class="flex cursor-default items-center gap-4 rounded-r-xl border-l-4 border-transparent px-8 py-4 text-sm font-bold text-muted/50">
          <i class="fa-solid <%= item[:icon] %>"></i>
          <%= item[:label] %>
        </span>
      <% end %>
    <% end %>
  </nav>

  <div class="px-4 py-6">
    <div class="flex items-center gap-3 rounded-xl px-4 py-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-teal text-sm font-bold text-white">
        <%= current_user.name.first.upcase %>
      </span>
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-bold"><%= current_user.name %></p>
        <p class="truncate text-xs text-muted"><%= current_user.email %></p>
      </div>
    </div>
    <%= button_to "Sign out", destroy_user_session_path, method: :delete,
          class: "mt-2 flex w-full items-center gap-4 rounded-xl px-4 py-3 text-sm font-bold text-muted transition-colors hover:text-beige" %>
  </div>
</aside>
