<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Finance" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Finance">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;700&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://kit.fontawesome.com/2f10e5b748.js" crossorigin="anonymous"></script>
  </head>

  <body class="bg-beige font-sans text-navy antialiased">
    <% if user_signed_in? %>
      <div class="lg:flex lg:min-h-screen">
        <%= render "layouts/sidebar" %>

        <main class="flex-1 px-4 pt-6 pb-24 sm:px-10 sm:py-8 lg:pb-8">
          <%= render "layouts/flash" %>
          <%= yield %>
        </main>
      </div>

      <%= render "layouts/mobile_nav" %>
    <% else %>
      <main class="flex min-h-screen items-center gap-6 p-4 lg:p-6">
        <%# Dark illustration panel — desktop only %>
        <div class="relative hidden h-[calc(100vh-3rem)] w-[560px] shrink-0 overflow-hidden rounded-xl bg-navy lg:block">
          <%= image_tag "Login and Signup Illustration Image.svg", alt: "",
                class: "absolute inset-0 h-full w-full object-cover" %>

          <%# Wordmark — top-left, clear of the artwork %>
          <p class="absolute left-10 top-10 text-2xl font-bold text-white">finance</p>

          <%# Bottom content zone: gradient scrim keeps text legible over the art %>
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 via-black/40 to-transparent px-10 pb-10 pt-32">
            <div class="max-w-[26rem]">
              <h2 class="text-3xl font-bold leading-snug text-white">Keep track of your money and save for your future</h2>
              <p class="mt-4 text-sm text-white/70">Personal finance app puts you in control of your spending. Track transactions, set budgets, and add to savings pots easily.</p>
            </div>
          </div>
        </div>

        <%# Auth card %>
        <div class="flex flex-1 justify-center">
          <div class="w-full max-w-md">
            <%= render "layouts/flash" %>
            <%= yield %>
          </div>
        </div>
      </main>
    <% end %>
  </body>
</html>
