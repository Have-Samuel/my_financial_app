<div class="mx-auto max-w-6xl space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold">Pots</h1>
    <%= link_to "+ Add New Pot", new_pot_path,
          class: "rounded-lg bg-navy px-4 py-3 text-sm font-bold text-white" %>
  </div>

  <% if @pots.any? %>
    <div class="grid gap-6 sm:grid-cols-2">
      <% @pots.each do |pot| %>
        <% saved = pot.saved_cents %>
        <% pct = [(saved / pot.target_cents.to_f * 100), 100].min %>

        <section class="rounded-xl bg-white p-6">
          <div class="flex items-center justify-between">
            <h2 class="flex items-center gap-3 text-lg font-bold">
              <span class="h-4 w-4 rounded-full" style="background-color: <%= pot.color || '#277c78' %>"></span>
              <%= pot.name %>
            </h2>
            <div class="flex items-center gap-1 text-muted">
              <%= link_to edit_pot_path(pot), class: "px-2 py-1 hover:text-navy", title: "Edit" do %>
                <i class="fa-solid fa-pen-to-square"></i>
              <% end %>
              <%= button_to pot_path(pot), method: :delete,
                    data: { turbo_confirm: "Delete this pot? Its ledger entries will be removed." },
                    class: "px-2 py-1 hover:text-red", title: "Delete" do %>
                <i class="fa-solid fa-trash-can"></i>
                <% end %>
            </div>
          </div>

          <div class="mt-5 flex items-end justify-between">
            <div>
              <p class="text-xs text-muted">Total Saved</p>
              <p class="mt-1 text-3xl font-bold"><%= money(saved) %></p>
            </div>
            <div class="text-right">
              <p class="text-xs font-bold <%= 'text-teal' if pct >= 100 %>"><%= pct.round(2) %>%</p>
              <p class="text-xs text-muted">of <%= money(pot.target_cents) %></p>
            </div>
          </div>

          <div class="mt-3 h-2 overflow-hidden rounded-full bg-beige">
            <div class="h-full rounded-full transition-all" style="width: <%= pct %>%; background-color: <%= pot.color || '#277c78' %>"></div>
          </div>

          <div class="mt-5 flex gap-4">
            <%= link_to "+ Add Money", new_pot_pot_transaction_path(pot, kind: "deposit"),
                  class: "flex-1 rounded-lg border border-beige bg-beige py-3 text-center text-sm font-bold transition-colors hover:bg-navy hover:text-white" %>
            <%= link_to "Withdraw", new_pot_pot_transaction_path(pot, kind: "withdrawal"),
                  class: "flex-1 rounded-lg border border-beige bg-beige py-3 text-center text-sm font-bold transition-colors hover:bg-navy hover:text-white" %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <section class="rounded-xl bg-white p-10 text-center">
      <p class="text-sm text-muted">No pots yet. Create a savings goal to get started.</p>
      <%= link_to "+ Add New Pot", new_pot_path,
            class: "mt-4 inline-block rounded-lg bg-navy px-4 py-3 text-sm font-bold text-white" %>
    </section>
  <% end %>
</div>
